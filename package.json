{
  "name": "bet-scanner",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "data:build": "node scripts/build-data.mjs",
    "model:build": "node --import ./scripts/register-typescript.mjs scripts/build-models.mjs",
    "corners:data:build": "node --import ./scripts/register-typescript.mjs scripts/build-corners-data.mjs",
    "corners:model:build": "node --import ./scripts/register-typescript.mjs scripts/build-corners-models.mjs",
    "corners:build": "pnpm corners:data:build && pnpm corners:model:build",
    "value:data:build": "node --import ./scripts/register-typescript.mjs scripts/build-value-data.mjs",
    "value:model:build": "node --import ./scripts/register-typescript.mjs scripts/build-value-models.mjs",
    "value:build": "pnpm value:data:build && pnpm value:model:build",
    "calibration:model:build": "node --import ./scripts/register-typescript.mjs scripts/build-calibration-models.mjs",
    "calibration:build": "pnpm value:data:build && pnpm calibration:model:build"
  },
  "dependencies": {
    "next": "16.3.8",
    "numeric": "1.2.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@9.15.0"
}
